<MainLayout title="Rassegna stampa | Guido Chiesa" description="Recensioni, interviste e articoli su Guido Chiesa.">
  <section class="mx-auto max-w-3xl px-6 py-16 lg:py-24">

    <h1 class="text-5xl font-semibold tracking-[-0.07em] text-zinc-900 sm:text-6xl">Rassegna stampa</h1>

    {anni.map((anno) => (
      <div class="mt-16">
        <h2 class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-zinc-400">{anno.year}</h2>
        <div class="divide-y divide-zinc-100 overflow-hidden rounded-2xl border border-zinc-100 bg-white shadow-sm">
          {anno.films.map((film) => {
            const meta = filmMetadata[film.slug] ?? {};
            const videos = (meta.rassegnaVideo ?? []).filter((v: any) => !v.lang || v.lang === 'it');
            return (
              <details id={film.id} class="rs-item group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 transition hover:bg-zinc-50">
                  <div>
                    <span class="block text-base font-semibold text-zinc-900">{film.title}</span>
                    <span class="mt-0.5 block text-xs text-zinc-400">
                      {film.items.length} {film.items.length === 1 ? 'recensione' : 'recensioni'}
                      {videos.length > 0 && ` · ${videos.length} video`}
                    </span>
                  </div>
                  <div class="flex shrink-0 items-center gap-3">
                    <a href={base + `filmografia/${film.slug}/`}
                      class="hidden text-xs font-medium text-zinc-400 underline underline-offset-2 transition hover:text-emerald-600 sm:block"
                      onclick="event.stopPropagation()">
                      Scheda film →
                    </a>
                    <span class="rs-chevron flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-zinc-200 text-zinc-400 text-xs transition">↓</span>
                  </div>
                </summary>
                <div class="border-t border-zinc-100 px-6 pb-7 pt-5">
                  {film.items.length > 0 && (
                    <div>
                      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.15em] text-zinc-400">Recensioni</p>
                      <ul class="space-y-1">
                        {film.items.map((item) => (
                          <li>
                            {item.href ? (
                              <a href={item.href.startsWith('/') ? base + item.href.slice(1) : item.href} target="_blank" rel="noopener noreferrer"
                                class="group/link flex items-center justify-between rounded-lg px-3 py-2.5 transition hover:bg-zinc-50">
                                <span>
                                  <span class="block text-sm font-medium text-zinc-800 transition group-hover/link:text-emerald-700">{item.title}</span>
                                  {item.source && <span class="block text-xs text-zinc-400">{item.source}</span>}
                                </span>
                                <span class="shrink-0 text-xs font-semibold uppercase tracking-wide text-zinc-300 transition group-hover/link:text-emerald-500">
                                  {item.isImg ? 'IMG' : 'PDF'} ↗
                                </span>
                              </a>
                            ) : (
                              <div class="flex items-center justify-between rounded-lg px-3 py-2.5">
                                <span>
                                  <span class="block text-sm font-medium text-zinc-500">{item.title}</span>
                                  {item.source && <span class="block text-xs text-zinc-400">{item.source}</span>}
                                </span>
                              </div>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {videos.length > 0 && (
                    <div class:list={[film.items.length > 0 && "mt-6"]}>
                      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.15em] text-zinc-400">Video</p>
                      <div class="flex flex-wrap gap-2">
                        {videos.map((v: any) => (
                          <a href={v.url} target="_blank" rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 rounded-full border border-zinc-800 bg-zinc-900 px-3 py-1.5 text-xs font-medium text-white transition hover:bg-zinc-700">
                            {v.label}<span aria-hidden="true" class="text-zinc-500">↗</span>
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </details>
            );
          })}
        </div>
      </div>
    ))}
  </section>
</MainLayout>

<style>
  details.rs-item[open] .rs-chevron { transform: rotate(180deg); border-color: #18181b; color: #18181b; }
  details.rs-item summary::-webkit-details-marker { display: none; }
  details.rs-item summary::marker { display: none; }
</style>
