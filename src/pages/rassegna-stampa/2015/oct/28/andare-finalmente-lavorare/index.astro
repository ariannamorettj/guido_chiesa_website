---
import MainLayout from '../../../../../../layouts/MainLayout.astro';
---
<MainLayout title="Belli di papà, andate (finalmente) a lavorare | Guido Chiesa" description="2015 — Belli di papà">
  <article class="mx-auto max-w-3xl px-6 py-16 lg:py-24">
    <div class="mb-8">
      <div class="text-xs font-semibold uppercase tracking-[0.16em] text-zinc-400">2015 — Belli di papà</div>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.06em] text-zinc-900 sm:text-5xl">Belli di papà, andate (finalmente) a lavorare</h1>
      <p class="mt-2 text-sm text-zinc-500">Claudio Trionfera — <span class="italic">Panorama</span>, 28 ottobre 2015</p>
    </div>
    <div class="prose-guido space-y-5 text-base leading-8 text-zinc-700">
      <p>L'articolo completo è disponibile sul sito di <em>Panorama</em>.</p>
      <a
        href="https://www.panorama.it/attualita/belli-di-papa-andate-finalmente-lavorare"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-md bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-800"
      >
        Leggi su Panorama &rarr;
      </a>
    </div>
    <div class="mt-16 border-t border-zinc-100 pt-8">
      <a href={import.meta.env.BASE_URL + "rassegna-stampa/"} class="text-sm font-semibold text-emerald-700 transition hover:text-emerald-800">&larr; Torna alla rassegna stampa</a>
    </div>
  </article>
</MainLayout>
