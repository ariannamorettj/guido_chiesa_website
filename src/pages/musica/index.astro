---
import MainLayout from '../../layouts/MainLayout.astro';
import { lungometraggi, cortometraggi, serial, documentari, videoclip } from '../../data/filmografia';
import type { FilmItem } from '../../data/filmografia';
import { filmMetadata } from '../../data/filmMetadata';

const base = import.meta.env.BASE_URL;

type ColonnaSonora = { year: number; title: string; href: string; composer?: string };

function slugFromHref(href: string | null): string | null {
  return href?.match(/^\/filmografia\/([^/]+)\/$/)?.[1] ?? null;
}

function colonneSonoreFromFilms(films: FilmItem[]): ColonnaSonora[] {
  const out: ColonnaSonora[] = [];
  for (const film of films) {
    const slug = slugFromHref(film.href);
    if (!slug) continue;
    const meta = filmMetadata[slug];
    if (!meta) continue;

    // Ha una colonna sonora (YouTube in linkEsterni o player self-hosted)?
    // In entrambi i casi si punta alla scheda del film sul sito, mai
    // direttamente a una risorsa esterna: da qui si arriva sempre al film,
    // e dalla scheda del film si arriva eventualmente a YouTube.
    const hasExternal = meta.linkEsterni?.some((l) => l.label === 'Colonna sonora' && l.url);
    const hasSelfHosted = meta.colonnaSonora && meta.colonnaSonora.length > 0;
    if (hasExternal || hasSelfHosted) {
      out.push({
        year: film.year,
        title: film.title,
        href: `/filmografia/${slug}/#colonna-sonora`,
        composer: meta.scheda?.musiche,
      });
    }
  }
  return out;
}

const colonneSonore = [
  ...colonneSonoreFromFilms(lungometraggi),
  ...colonneSonoreFromFilms(cortometraggi),
  ...colonneSonoreFromFilms(serial),
  ...colonneSonoreFromFilms(documentari),
  ...colonneSonoreFromFilms(videoclip),
].sort((a, b) => b.year - a.year);
---

<MainLayout title="Musica | Guido Chiesa" description="Musica e colonne sonore legate ai progetti di Guido Chiesa.">
  <section class="mx-auto max-w-7xl px-6 py-16 lg:py-24">

    <div class="max-w-3xl">
      <h1 class="text-5xl font-semibold tracking-[-0.07em] text-zinc-900 sm:text-6xl">Musica</h1>
      <blockquote class="mt-8">
        <p>La musica ha sempre rivestito un ruolo centrale nel mio lavoro. Pensare a una storia da raccontare, a un'immagine da realizzare significa evocare una musica da ascoltare.</p>
        <p>Sono un musicista mancato più che fallito, ma non mi vergogno di dire che la musica mi ha salvato la vita. Nessun linguaggio combina con altrettanta felicità ragione e emozione, materialità e trascendenza.</p>
      </blockquote>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-semibold tracking-[-0.04em] text-zinc-900">Colonne sonore</h2>
      <ul class="mt-6 divide-y divide-black/5">
        {colonneSonore.map((item) => (
          <li class="flex items-baseline gap-4 py-4">
            <span class="w-12 shrink-0 text-sm font-semibold tabular-nums text-zinc-400">{item.year}</span>
            <div>
              <a
                href={base + item.href.slice(1)}
                class="text-base font-medium text-zinc-800 transition hover:text-emerald-700"
              >
                {item.title}
              </a>
              {item.composer && (
                <span class="block text-sm text-zinc-400">musiche di {item.composer}</span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>

  </section>
</MainLayout>
