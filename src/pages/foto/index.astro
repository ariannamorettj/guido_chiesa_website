---
import MainLayout from '../../layouts/MainLayout.astro';
import { lungometraggi, cortometraggi, serial, documentari, videoclip } from '../../data/filmografia';
import type { FilmItem } from '../../data/filmografia';
import { filmMetadata } from '../../data/filmMetadata';

// Le gallerie astro effettivamente pubblicate sotto /foto/<slug>/ (fonte di verità
// per l'esistenza della pagina, indipendente dai dati dei film).
const fotoPages = import.meta.glob('./*/index.astro');
const existingGallerySlugs = new Set(
  Object.keys(fotoPages)
    .map((path) => path.match(/^\.\/([^/]+)\/index\.astro$/)?.[1])
    .filter((slug): slug is string => Boolean(slug))
);

type Gallery = { year: number; title: string; thumb: string; href: string };

function slugFromHref(href: string | null): string | null {
  return href?.match(/^\/filmografia\/([^/]+)\/$/)?.[1] ?? null;
}

function gallerySlugFromPath(path: string): string | null {
  return path.match(/^\/foto\/([^/]+)\/$/)?.[1] ?? null;
}

// Gallerie referenziate dai dati del film ma senza una pagina /foto/ corrispondente:
// non generano un link rotto, vengono solo segnalate qui (vedi report al committente).
const missingGalleries: { title: string; slug: string; path: string }[] = [];

function galleriesFromFilms(films: FilmItem[]): Gallery[] {
  const out: Gallery[] = [];
  for (const film of films) {
    const slug = slugFromHref(film.href);
    if (!slug) continue;
    const meta = filmMetadata[slug];
    if (!meta) continue;

    // Stessa risoluzione usata in filmografia/[slug].astro per il link "Galleria foto".
    const path = meta.fotoUrl ?? meta.fotoGallery ?? (meta.fotoGalleria ? `/foto/${slug}/` : null);
    if (!path) continue;

    const gallerySlug = gallerySlugFromPath(path);
    if (!gallerySlug || !existingGallerySlugs.has(gallerySlug)) {
      missingGalleries.push({ title: film.title, slug, path });
      continue;
    }

    const thumb = meta.foto ?? meta.heroPhoto?.src ?? meta.stills?.[0]?.src;
    if (!thumb) continue;

    out.push({ year: film.year, title: film.title, thumb, href: path });
  }
  return out;
}

const filmGalleries = [
  ...galleriesFromFilms(lungometraggi),
  ...galleriesFromFilms(cortometraggi),
  ...galleriesFromFilms(serial),
  ...galleriesFromFilms(documentari),
  ...galleriesFromFilms(videoclip),
];

// Gallerie non legate a una scheda film: collaborazioni citate solo in Biografia
// (Guido Chiesa come aiuto regia/produzione, non regista).
const extraGalleries: Gallery[] = [
  { year: 1988, title: "The Hole", thumb: "/images/foto/the-hole.jpg", href: "/foto/the-hole/" },
  { year: 1985, title: "Down by Law", thumb: "/images/foto/down-by-law.jpg", href: "/foto/down-by-law/" },
  { year: 1984, title: "Stranger Than Paradise", thumb: "/images/foto/stranger-than-paradise.jpg", href: "/foto/stranger-than-paradise/" },
];

const galleries: Gallery[] = [...filmGalleries, ...extraGalleries].sort((a, b) => b.year - a.year);
---

<MainLayout title="Foto | Guido Chiesa" description="Gallerie fotografiche di Guido Chiesa: stills, backstage e ritratti.">
  <section class="mx-auto max-w-7xl px-6 py-16 lg:py-24">

    <h1 class="text-5xl font-semibold tracking-[-0.07em] text-zinc-900 sm:text-6xl">Foto</h1>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {galleries.map((g, i) => (
        g.href ? (
          <a
            href={import.meta.env.BASE_URL + g.href!.slice(1)}
            class="group overflow-hidden rounded-2xl border border-black/5 bg-white shadow-[0_8px_30px_-12px_rgba(0,0,0,0.14)] transition hover:-translate-y-0.5 hover:shadow-[0_16px_50px_-18px_rgba(0,0,0,0.22)]"
            data-reveal
            data-delay={i * 60}
          >
            <div class="aspect-[4/3] w-full overflow-hidden bg-zinc-100">
              <img
                src={import.meta.env.BASE_URL + g.thumb.slice(1)}
                alt={g.title}
                class="h-full w-full object-cover grayscale transition duration-500 group-hover:grayscale-0 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="px-4 py-3">
              <div class="text-xs font-semibold tabular-nums text-zinc-400">{g.year}</div>
              <div class="mt-0.5 flex items-center justify-between text-sm font-semibold text-zinc-800">
                {g.title}
                <span class="text-zinc-300 transition group-hover:translate-x-0.5 group-hover:text-emerald-600">→</span>
              </div>
            </div>
          </a>
        ) : (
          <div
            class="group overflow-hidden rounded-2xl border border-black/5 bg-white shadow-[0_8px_30px_-12px_rgba(0,0,0,0.14)]"
            data-reveal
            data-delay={i * 60}
          >
            <div class="aspect-[4/3] w-full overflow-hidden bg-zinc-100">
              <img
                src={import.meta.env.BASE_URL + g.thumb.slice(1)}
                alt={g.title}
                class="h-full w-full object-cover grayscale"
                loading="lazy"
              />
            </div>
            <div class="px-4 py-3">
              <div class="text-xs font-semibold tabular-nums text-zinc-400">{g.year}</div>
              <div class="mt-0.5 text-sm font-semibold text-zinc-500">{g.title}</div>
            </div>
          </div>
        )
      ))}
    </div>

  </section>
</MainLayout>
