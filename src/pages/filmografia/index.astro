---
import MainLayout from '../../layouts/MainLayout.astro';
import {
  type FilmItem,
  lungometraggi,
  cortometraggi,
  serial,
  documentari,
  videoclip,
} from '../../data/filmografia';
import { filmMetadata } from '../../data/filmMetadata';

const sections = [
  { label: "Lungometraggi", items: lungometraggi },
  { label: "Documentari", items: documentari },
  { label: "Serial", items: serial },
  { label: "Cortometraggi", items: cortometraggi },
  { label: "Videoclip", items: videoclip },
];

const total = sections.reduce((n, s) => n + s.items.length, 0);
const base = import.meta.env.BASE_URL;
---

<MainLayout title="Filmografia | Guido Chiesa" description="Filmografia completa di Guido Chiesa: lungometraggi, documentari, cortometraggi, serial e videoclip.">
  <section class="mx-auto max-w-7xl px-6 py-16 lg:py-24">

    <div class="max-w-3xl">
      <h1 class="text-5xl font-semibold tracking-[-0.07em] text-zinc-900 sm:text-6xl">Filmografia</h1>
      <blockquote class="mt-8">
        <p>Un elenco non significa molto in sé e per sé. Talvolta gli spazi tra un titolo e l'altro nascondono più di quanto i lavori realizzati riescano a spiegare. Se non altro il desiderio di proseguire oltre che si accompagna ad ogni parola "fine".</p>
      </blockquote>
    </div>

    <div class="mt-16 grid gap-12 lg:grid-cols-[1fr_280px]">

      <div class="space-y-14">
        {sections.map(({ label, items }) => (
          <div>
            <div class="mb-4 flex items-center gap-4">
              <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-400">{label}</h2>
              <div class="h-px flex-1 bg-zinc-100"></div>
            </div>

            <div class="space-y-0.5">
              {items.map((item) => {
                const slug = item.href ? item.href.replace('/filmografia/', '').replace(/\/$/, '') : null;
                const meta = slug ? (filmMetadata[slug] ?? {}) : {};
                const hasPresentazione = !!(meta.presentazione || meta.presentazioneEn);
                const hasLangToggle = !!(meta.presentazioneEn);

                if (hasPresentazione && slug) {
                  return (
                    <details class="film-item rounded-xl">
                      <summary class="flex cursor-pointer list-none items-baseline gap-5 px-4 py-2.5 rounded-xl transition hover:bg-white hover:shadow-[0_2px_12px_-4px_rgba(0,0,0,0.08)]">
                        <span class="w-10 shrink-0 text-sm tabular-nums text-zinc-400">{item.year}</span>
                        <span class="flex-1 text-base font-medium text-zinc-800">
                          {item.title}
                          {hasLangToggle && meta.titoloEn && (
                            <span class="font-normal text-zinc-400"> / {meta.titoloEn}</span>
                          )}
                        </span>
                        <span class="film-chevron self-center shrink-0 text-xs text-zinc-300">↓</span>
                      </summary>
                      <div class="film-dropdown pb-6 pl-4 pr-4 pt-2">
                        <div class="ml-[3.75rem]">
                          {hasLangToggle && (
                            <div class="mb-4 flex gap-2">
                              <button type="button" data-film-lang-btn="it" aria-pressed="true"
                                class="rounded-full border border-zinc-200 px-3 py-1 text-xs font-semibold transition aria-[pressed=true]:border-zinc-800 aria-[pressed=true]:bg-zinc-900 aria-[pressed=true]:text-white text-zinc-400 hover:text-zinc-900">IT</button>
                              <button type="button" data-film-lang-btn="en" aria-pressed="false"
                                class="rounded-full border border-zinc-200 px-3 py-1 text-xs font-semibold transition aria-[pressed=true]:border-zinc-800 aria-[pressed=true]:bg-zinc-900 aria-[pressed=true]:text-white text-zinc-400 hover:text-zinc-900">EN</button>
                            </div>
                          )}
                          {meta.presentazione && (
                            <p class="mb-5 text-sm leading-7 text-zinc-600" data-film-lang-content={hasLangToggle ? "it" : undefined}>{meta.presentazione}</p>
                          )}
                          {hasLangToggle && meta.presentazioneEn && (
                            <p class="hidden mb-5 text-sm leading-7 text-zinc-600" data-film-lang-content="en">{meta.presentazioneEn}</p>
                          )}
                          <a href={base + "filmografia/" + slug + "/"}
                            class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700 transition hover:text-emerald-800">
                            {hasLangToggle ? (
                              <>
                                <span data-film-lang-content="it">Scheda completa →</span>
                                <span class="hidden" data-film-lang-content="en">Full page →</span>
                              </>
                            ) : 'Scheda completa →'}
                          </a>
                        </div>
                      </div>
                    </details>
                  );
                }

                return (
                  <div class="flex items-baseline gap-5 px-4 py-2.5 rounded-xl transition hover:bg-white hover:shadow-[0_2px_12px_-4px_rgba(0,0,0,0.08)]">
                    <span class="w-10 shrink-0 text-sm tabular-nums text-zinc-400">{item.year}</span>
                    {slug ? (
                      <a href={base + "filmografia/" + slug + "/"} class="text-base font-medium text-zinc-800 transition hover:text-emerald-700">
                        {item.title}
                      </a>
                    ) : (
                      <span class="text-base font-medium text-zinc-500">{item.title}</span>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <aside class="lg:pt-1">
        <div class="sticky top-24 space-y-4">
          <div id="stats-card" class="rounded-3xl border border-black/5 bg-white p-6 shadow-[0_12px_40px_-24px_rgba(0,0,0,0.12)]">
            <div class="text-xs font-semibold uppercase tracking-[0.16em] text-zinc-400">In cifre</div>
            <ul class="mt-5 space-y-3">
              {sections.map(({ label, items }) => (
                <li class="flex items-center justify-between gap-4">
                  <span class="text-sm text-zinc-600">{label}</span>
                  <span class="text-sm font-semibold tabular-nums text-zinc-900" data-counter>{items.length}</span>
                </li>
              ))}
              <li class="flex items-center justify-between gap-4 border-t border-zinc-100 pt-4">
                <span class="text-sm font-semibold text-zinc-900">Totale</span>
                <span class="text-sm font-semibold tabular-nums text-emerald-700" data-counter>{total}</span>
              </li>
            </ul>
          </div>

          <div class="flex flex-col gap-3">
            {[
              { label: "Sceneggiature", href: base + "sceneggiature/" },
              { label: "Rassegna stampa", href: base + "rassegna-stampa/" },
              { label: "Biografia", href: base + "biografia/" },
            ].map(({ label, href }) => (
              <a href={href} class="group flex items-center justify-between rounded-2xl border border-black/5 bg-white px-5 py-3.5 text-sm font-medium text-zinc-700 transition hover:-translate-y-0.5 hover:shadow-[0_8px_24px_-12px_rgba(0,0,0,0.16)]">
                {label}
                <span class="text-zinc-400 transition group-hover:translate-x-0.5 group-hover:text-emerald-700">→</span>
              </a>
            ))}
          </div>
        </div>
      </aside>

    </div>
  </section>
</MainLayout>


<script>
  const stored = localStorage.getItem('film-lang') ?? 'it';

  document.querySelectorAll<HTMLElement>('details.film-item').forEach((details) => {
    const btns = details.querySelectorAll<HTMLButtonElement>('[data-film-lang-btn]');
    if (!btns.length) return;

    const contents = details.querySelectorAll<HTMLElement>('[data-film-lang-content]');

    function setLang(lang: string) {
      contents.forEach(el => {
        const target = el.dataset.filmLangContent;
        if (target === 'it' || target === 'en') {
          el.hidden = target !== lang;
          el.classList.toggle('hidden', target !== lang);
        }
      });
      btns.forEach(btn => {
        btn.setAttribute('aria-pressed', String(btn.dataset.filmLangBtn === lang));
      });
      localStorage.setItem('film-lang', lang);
    }

    btns.forEach(btn => {
      btn.addEventListener('click', () => setLang(btn.dataset.filmLangBtn!));
    });

    setLang(stored === 'en' ? 'en' : 'it');
  });

  function slotCounter(el: HTMLElement) {
    const target = parseInt(el.textContent?.trim() ?? '0', 10);
    if (isNaN(target)) return;

    const isDouble = target >= 10;
    let ticks = 0;
    const maxTicks = 9;

    const spin = setInterval(() => {
      ticks++;
      el.textContent = isDouble
        ? String(Math.floor(Math.random() * 90 + 10))
        : String(Math.floor(Math.random() * 10));

      if (ticks >= maxTicks) {
        clearInterval(spin);
        const duration = 380;
        const t0 = performance.now();
        function countUp(now: number) {
          const p = Math.min((now - t0) / duration, 1);
          const eased = 1 - Math.pow(1 - p, 2);
          el.textContent = String(Math.round(eased * target));
          if (p < 1) requestAnimationFrame(countUp);
          else el.textContent = String(target);
        }
        requestAnimationFrame(countUp);
      }
    }, 55);
  }

  const statsCard = document.getElementById('stats-card');
  if (statsCard) {
    let triggered = false;

    function runSlot() {
      if (triggered) return;
      triggered = true;
      const counters = statsCard.querySelectorAll<HTMLElement>('[data-counter]');
      counters.forEach((el, i) => setTimeout(() => slotCounter(el), i * 110));
    }

    const obs = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        obs.disconnect();
        runSlot();
      }
    }, { threshold: 0.5, rootMargin: '-40px 0px -40px 0px' });

    window.addEventListener('scroll', function onFirstScroll() {
      window.removeEventListener('scroll', onFirstScroll);
      obs.observe(statsCard);
    }, { passive: true });
  }
</script>

<style>
  @keyframes filmDropIn {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  details.film-item summary::-webkit-details-marker { display: none; }
  details.film-item summary::marker { display: none; }
  details.film-item[open] {
    background: white;
    border-radius: 0.75rem;
    box-shadow: 0 2px 12px -4px rgba(0,0,0,0.08);
  }
  details.film-item[open] > summary {
    border-bottom: 1px solid #f4f4f5;
    border-radius: 0.75rem 0.75rem 0 0;
  }
  details.film-item[open] .film-dropdown { animation: filmDropIn 160ms ease; }
  details.film-item[open] .film-chevron { transform: rotate(180deg); color: #18181b; }
  .film-chevron { transition: transform 150ms ease, color 150ms ease; }
</style>
