---
import MainLayout from '../../layouts/MainLayout.astro';
import {
  lungometraggi,
  cortometraggi,
  serial,
  documentari,
  videoclip,
  type FilmItem,
} from '../../data/filmografia';
import { filmMetadata } from '../../data/filmMetadata';

type FilmEntry = FilmItem & { categoria: string };

export async function getStaticPaths() {
  const all: FilmEntry[] = [
    ...lungometraggi.map(f => ({ ...f, categoria: 'Lungometraggio' as const })),
    ...cortometraggi.map(f => ({ ...f, categoria: 'Cortometraggio' as const })),
    ...serial.map(f => ({ ...f, categoria: 'Serial' as const })),
    ...documentari.map(f => ({ ...f, categoria: 'Documentario' as const })),
    ...videoclip.map(f => ({ ...f, categoria: 'Videoclip' as const })),
  ];
  return all
    .filter(f => f.href)
    .map(f => {
      const slug = f.href!.replace('/filmografia/', '').replace(/\/$/, '');
      return { params: { slug }, props: { film: f, slug } };
    });
}

const { film, slug } = Astro.props as { film: FilmEntry; slug: string };
const meta = filmMetadata[slug] ?? {};
const base = import.meta.env.BASE_URL;

function clean(html: string): string {
  return html
    .replace(/<p>\s*<h3>([^<]*)<\/h3>\s*(https?:\/\/[^\s<]+)\s*<\/p>/g,
      (_, label, url) => `<p><a href="${url.trim()}" target="_blank" rel="noopener">▶ ${label.trim() || 'Guarda'}</a></p>`)
    .replace(/<p>\s*<h3>[^<]*<\/h3>\s*<\/p>/g, '')
    .replace(/(<br>\s*)+$/g, '')
    .replace(/href="\.\.\/\.\.\/\.\.\/\.\.\//g, `href="${base}`)
    .replace(/href="\/(?!\/)/g, `href="${base}`)
    .replace(/<a([^>]*)>\s*Link esterno\s*<\/a>/g, (_, attrs) => {
      const hasTarget = /target=/.test(attrs);
      const hasRel = /rel=/.test(attrs);
      return `<a${attrs} class="ext-pill"${hasTarget ? '' : ' target="_blank"'}${hasRel ? '' : ' rel="noopener"'}>↗ Link esterno</a>`;
    })
    .replace(/<p>\s*<strong>Sinossi<\/strong>\s*<\/p>/gi, '<h3 class="film-section-label">Sinossi</h3>')
    .replace(/<p>\s*<strong>Note di regia\.<\/strong>\s*/gi, '<h3 class="film-section-label">Note di regia</h3><p>')
    .trim();
}

const content = film.content ? clean(film.content) : null;
const contentEn = meta.contentEn ? clean(meta.contentEn) : null;

// Normalizza stills (nuovo array > vecchio campo foto)
const stills = meta.heroPhoto
  ? [meta.heroPhoto]
  : meta.stills ?? (meta.foto ? [{ src: meta.foto, alt: `${film.title} – foto di scena` }] : []);

// Normalizza poster
const posterSrc = meta.poster?.src ?? meta.locandina ?? null;
const posterAlt = meta.poster?.alt ?? `${film.title} – locandina`;

// Normalizza gallery url
const galleryUrl = meta.fotoUrl
  ?? meta.fotoGallery
  ?? (meta.fotoGalleria ? `/foto/${slug}/` : null);

// Toggle IT/EN — attivo se esiste presentazioneEn o posterEn
const hasLangToggle = !!(meta.presentazioneEn || meta.posterEn);

// Video filtrati per lingua (usati lato server per i dati)
const videoIt = (meta.video ?? []).filter(v => !v.lang || v.lang === 'it');
const videoEn = (meta.video ?? []).filter(v => !v.lang || v.lang === 'en');
const videoAll = meta.video ?? [];

// Link esterni (esclude quelli pending senza URL)
const linkEsterniAll  = (meta.linkEsterni ?? []).filter(l => l.url);
const linkEsterniPending = (meta.linkEsterni ?? []).filter(l => !l.url && l.pending);
// Per lingua: senza lang = appare sempre; con lang = filtrato
const linkEsterniIt = linkEsterniAll.filter(l => !l.lang || l.lang === 'it');
const linkEsterniEn = linkEsterniAll.filter(l => !l.lang || l.lang === 'en');
const linkEsterniVisibili = linkEsterniAll; // usato solo per hasLinkFascia

const schedaRows = meta.scheda
  ? Object.entries({
      Regia:          meta.scheda.regia,
      Soggetto:       meta.scheda.soggetto,
      Sceneggiatura:  meta.scheda.sceneggiatura,
      Produzione:     meta.scheda.produzione,
      Produttore:     meta.scheda.produttore,
      Interpreti:     meta.scheda.interpreti,
      Fotografia:     meta.scheda.fotografia,
      Scenografia:    meta.scheda.scenografia,
      Costumi:        meta.scheda.costumi,
      Montaggio:      meta.scheda.montaggio,
      Musiche:        meta.scheda.musiche,
      Durata:         meta.scheda.durata,
      Distribuzione:  meta.scheda.distribuzione,
      Genere:         meta.scheda.genere,
    }).filter(([, v]) => v !== undefined && v !== '')
  : [];

const schedaLabelsEn: Record<string, string> = {
  'Regia':          'Direction',
  'Soggetto':       'Story',
  'Sceneggiatura':  'Screenplay',
  'Produzione':     'Production',
  'Produttore':     'Producer',
  'Interpreti':     'Cast',
  'Fotografia':     'Cinematography',
  'Scenografia':    'Production design',
  'Costumi':        'Costume design',
  'Montaggio':      'Editing',
  'Musiche':        'Music',
  'Durata':         'Running time',
  'Distribuzione':  'Distribution',
  'Genere':         'Genre',
};

const hasLinkFascia = videoAll.length > 0
  || meta.rassegnaStampaAnno
  || meta.rassegnaStampaUrl
  || galleryUrl;
---

<MainLayout
  title={`${film.title} (${film.year}) | Filmografia | Guido Chiesa`}
  description={`${film.title} (${film.year}) — ${film.categoria} di Guido Chiesa.`}
>
  <section class="mx-auto max-w-5xl px-6 py-14 lg:py-20">

    <!-- Breadcrumb -->
    <nav class="mb-10 flex items-center gap-2 text-sm text-zinc-400">
      <a href={base + "filmografia/"} class="transition hover:text-zinc-700">Filmografia</a>
      <span>→</span>
      <span class="text-zinc-700">{film.title}</span>
    </nav>

    <!-- Foto di scena (hero) — prima del titolo, full width -->
    {stills.length === 1 && (
      <div class="mb-10 overflow-hidden rounded-2xl bg-zinc-950 shadow-[0_24px_60px_-20px_rgba(0,0,0,0.40)]">
        <img
          src={base + stills[0].src.replace(/^\//, '')}
          alt={stills[0].alt}
          class="aspect-[3/2] w-full object-cover"
          loading="lazy"
          width="900"
          height="600"
        />
        {'caption' in stills[0] && stills[0].caption && (
          <p class="px-5 py-3 text-xs italic text-zinc-400">{stills[0].caption}</p>
        )}
      </div>
    )}
    {stills.length >= 2 && (
      <div class="mb-10 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {stills.map((still) => (
          <div class="overflow-hidden rounded-xl bg-zinc-950 shadow-[0_8px_24px_-10px_rgba(0,0,0,0.30)]">
            <img
              src={base + still.src.replace(/^\//, '')}
              alt={still.alt}
              class="aspect-[3/2] w-full object-cover"
              loading="lazy"
              width="400"
              height="267"
            />
            {'caption' in still && still.caption && (
              <p class="px-3 py-2 text-xs italic text-zinc-400">{still.caption}</p>
            )}
          </div>
        ))}
      </div>
    )}

    <!-- Titolo + anno + toggle IT/EN -->
    <div class="mb-10">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-zinc-500">
            {film.categoria}
          </span>
          <span class="text-sm tabular-nums text-zinc-400" data-field="anno">
            {film.year}
          </span>
          {meta.annoEn && hasLangToggle && (
            <span class="hidden text-sm tabular-nums text-zinc-400" data-field="anno-en">
              {meta.annoEn}
            </span>
          )}
        </div>

        {hasLangToggle && (
          <div role="group" aria-label="Lingua"
            class="inline-flex overflow-hidden rounded-full border border-zinc-200 bg-white text-sm font-medium shadow-sm">
            <button type="button" data-lang-btn="it" aria-pressed="true"
              class="px-4 py-1.5 transition aria-[pressed=true]:bg-zinc-900 aria-[pressed=true]:text-white text-zinc-500 hover:text-zinc-900">IT</button>
            <button type="button" data-lang-btn="en" aria-pressed="false"
              class="px-4 py-1.5 transition aria-[pressed=true]:bg-zinc-900 aria-[pressed=true]:text-white text-zinc-500 hover:text-zinc-900">EN</button>
          </div>
        )}
      </div>

      <h1 class="text-4xl font-semibold tracking-[-0.06em] text-zinc-900 sm:text-5xl">
        <span data-field="titolo">{film.title}</span>
        {meta.titoloEn && hasLangToggle && (
          <span class="hidden" data-field="titolo-en">{meta.titoloEn}</span>
        )}
      </h1>
    </div>

    <!-- 3. Locandina — standalone, centrata -->
    {posterSrc && !meta.posterEn && (
      <div class="mb-10 flex justify-center">
        <div style="width:220px">
          <div class="overflow-hidden rounded-xl shadow-[0_12px_40px_-16px_rgba(0,0,0,0.35)]">
            <img
              src={base + posterSrc.replace(/^\//, '')}
              alt={posterAlt}
              class="w-full object-cover"
              loading="lazy"
              width="220"
              height="312"
            />
          </div>
          {meta.didascalia && (
            <p class="mt-3 text-center text-xs italic leading-relaxed text-zinc-400">{meta.didascalia}</p>
          )}
        </div>
      </div>
    )}
    {posterSrc && meta.posterEn && (
      <>
        <div class="mb-10" data-lang-content="it">
          <div style="width:220px" class="mx-auto">
            <div class="overflow-hidden rounded-xl shadow-[0_12px_40px_-16px_rgba(0,0,0,0.35)]">
              <img
                src={base + posterSrc.replace(/^\//, '')}
                alt={posterAlt}
                class="w-full object-cover"
                loading="lazy"
                width="220"
                height="312"
              />
            </div>
          </div>
        </div>
        <div class="mb-10 hidden" data-lang-content="en">
          <div style="width:220px" class="mx-auto">
            <div class="overflow-hidden rounded-xl shadow-[0_12px_40px_-16px_rgba(0,0,0,0.35)]">
              <img
                src={base + meta.posterEn.src.replace(/^\//, '')}
                alt={meta.posterEn.alt}
                class="w-full object-cover"
                loading="lazy"
                width="220"
                height="312"
              />
            </div>
          </div>
        </div>
      </>
    )}

    <!-- 4. Pressbook e link esterni -->
    {linkEsterniAll.length > 0 && (
      <div class="mb-10">
        {!hasLangToggle && (
          <div class="flex flex-wrap gap-3">
            {linkEsterniAll.map((link) => (
              <a href={link.url?.startsWith('/') ? base + link.url.slice(1) : link.url} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-full border border-emerald-600 bg-emerald-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-emerald-700 hover:border-emerald-700">
                {link.label}<span aria-hidden="true" class="text-emerald-200">↗</span>
              </a>
            ))}
          </div>
        )}
        {hasLangToggle && linkEsterniIt.length > 0 && (
          <div class="flex flex-wrap gap-3" data-lang-content="it">
            {linkEsterniIt.map((link) => (
              <a href={link.url?.startsWith('/') ? base + link.url.slice(1) : link.url} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-full border border-emerald-600 bg-emerald-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-emerald-700 hover:border-emerald-700">
                {link.label}<span aria-hidden="true" class="text-emerald-200">↗</span>
              </a>
            ))}
          </div>
        )}
        {hasLangToggle && linkEsterniEn.length > 0 && (
          <div class="hidden flex-wrap gap-3" data-lang-content="en">
            {linkEsterniEn.map((link) => (
              <a href={link.url?.startsWith('/') ? base + link.url.slice(1) : link.url} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-full border border-emerald-600 bg-emerald-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-emerald-700 hover:border-emerald-700">
                {link.label}<span aria-hidden="true" class="text-emerald-200">↗</span>
              </a>
            ))}
          </div>
        )}
      </div>
    )}

    <!-- 5. Scheda tecnica -->
    {schedaRows.length > 0 && (
      <div class="mb-12">
        <h2 class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-zinc-400">
          {hasLangToggle
            ? <><span data-lang-content="it">Scheda tecnica</span><span class="hidden" data-lang-content="en">Technical details</span></>
            : 'Scheda tecnica'}
        </h2>
        <dl class="divide-y divide-zinc-100 rounded-2xl border border-zinc-100 bg-white shadow-sm">
          {schedaRows.map(([label, value]) => (
            <div class="grid grid-cols-[140px_1fr] gap-4 px-5 py-3">
              {hasLangToggle ? (
                <>
                  <dt class="text-sm font-medium text-zinc-500" data-lang-content="it">{label}</dt>
                  <dt class="hidden text-sm font-medium text-zinc-500" data-lang-content="en">{schedaLabelsEn[label] ?? label}</dt>
                </>
              ) : (
                <dt class="text-sm font-medium text-zinc-500">{label}</dt>
              )}
              <dd class="text-sm text-zinc-800">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    <!-- Fascia link: Link e Video come sezioni distinte -->
    {hasLinkFascia && (
      <div class="mb-10 space-y-8 border-t border-zinc-100 pt-10">

        {/* ─── SEZIONE LINK (galleria + rassegna stampa) ─── */}
        {(meta.rassegnaStampaAnno || meta.rassegnaStampaUrl || galleryUrl) && (
          <div>
            <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-zinc-400">Link</h2>

            {/* Galleria fotografica e rassegna stampa */}
            {(galleryUrl || meta.rassegnaStampaAnno || meta.rassegnaStampaUrl) && (
              <div class="flex flex-wrap gap-3">
                {galleryUrl && (
                  <>
                    <a href={base + galleryUrl.replace(/^\//, '')}
                      class="inline-flex items-center gap-1.5 rounded-full border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-800 shadow-sm transition hover:border-zinc-400 hover:shadow-md"
                      data-lang-content={hasLangToggle ? "it" : undefined}>
                      Galleria fotografica <span aria-hidden="true" class="text-zinc-400">→</span>
                    </a>
                    {hasLangToggle && (
                      <a href={base + galleryUrl.replace(/^\//, '')}
                        class="hidden inline-flex items-center gap-1.5 rounded-full border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-800 shadow-sm transition hover:border-zinc-400 hover:shadow-md"
                        data-lang-content="en">
                        Photo gallery <span aria-hidden="true" class="text-zinc-400">→</span>
                      </a>
                    )}
                  </>
                )}
                {(meta.rassegnaStampaAnno || meta.rassegnaStampaUrl) && (
                  <>
                    <a
                      href={meta.rassegnaStampaUrl ? base + meta.rassegnaStampaUrl.replace(/^\//, '') : base + 'rassegna-stampa/#' + slug}
                      class="inline-flex items-center gap-1.5 rounded-full border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-800 shadow-sm transition hover:border-zinc-400 hover:shadow-md"
                      data-lang-content={hasLangToggle ? "it" : undefined}
                    >
                      Rassegna stampa <span aria-hidden="true" class="text-zinc-400">→</span>
                    </a>
                    {hasLangToggle && (
                      <a
                        href={meta.rassegnaStampaUrl ? base + meta.rassegnaStampaUrl.replace(/^\//, '') : base + 'rassegna-stampa/#' + slug}
                        class="hidden inline-flex items-center gap-1.5 rounded-full border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-800 shadow-sm transition hover:border-zinc-400 hover:shadow-md"
                        data-lang-content="en"
                      >
                        Press coverage <span aria-hidden="true" class="text-zinc-400">→</span>
                      </a>
                    )}
                  </>
                )}
              </div>
            )}
          </div>
        )}

        {/* ─── SEZIONE VIDEO ─── */}
        {(videoAll.length > 0 || meta.trailer) && (
          <div>
            <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-zinc-400">Video</h2>

            {/* Link video — senza toggle */}
            {!hasLangToggle && videoAll.length > 0 && (
              <div class="mb-5 flex flex-wrap gap-3">
                {videoAll.map((v) => (
                  <a href={v.url} target="_blank" rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-full border border-zinc-800 bg-zinc-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-zinc-700">
                    {v.label}<span aria-hidden="true" class="text-zinc-400">↗</span>
                  </a>
                ))}
              </div>
            )}
            {/* Link video — IT con toggle */}
            {hasLangToggle && videoIt.length > 0 && (
              <div class="mb-5 flex flex-wrap gap-3" data-lang-content="it">
                {videoIt.map((v) => (
                  <a href={v.url} target="_blank" rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-full border border-zinc-800 bg-zinc-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-zinc-700">
                    {v.label}<span aria-hidden="true" class="text-zinc-400">↗</span>
                  </a>
                ))}
              </div>
            )}
            {/* Link video — EN con toggle */}
            {hasLangToggle && videoEn.length > 0 && (
              <div class="mb-5 hidden flex-wrap gap-3" data-lang-content="en">
                {videoEn.map((v) => (
                  <a href={v.url} target="_blank" rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-full border border-zinc-800 bg-zinc-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-zinc-700">
                    {v.label}<span aria-hidden="true" class="text-zinc-400">↗</span>
                  </a>
                ))}
              </div>
            )}

            {/* Trailer embed (legacy) — solo se non già coperto dai link video sopra */}
            {meta.trailer && videoAll.length === 0 && (
              <div class="overflow-hidden rounded-2xl bg-zinc-950 shadow-[0_24px_60px_-20px_rgba(0,0,0,0.40)]">
                <div class="relative aspect-video">
                  <iframe
                    src={meta.trailer}
                    title={`Trailer – ${film.title}`}
                    class="absolute inset-0 h-full w-full"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                  ></iframe>
                </div>
              </div>
            )}
          </div>
        )}

      </div>
    )}

    {/* ─── SEZIONE ALTRI MATERIALI ─── */}
    {meta.materialiExtra && meta.materialiExtra.length > 0 && (
      <div class="mt-10">
        <div class="mb-4 flex items-center gap-4">
          <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-400">Altri materiali</h2>
          <div class="h-px flex-1 bg-zinc-100"></div>
        </div>
        <div class="flex flex-wrap gap-3">
          {meta.materialiExtra.map((m) => (
            <a href={m.url} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 px-4 py-2 text-sm font-medium text-zinc-700 transition hover:border-zinc-400 hover:text-zinc-900">
              {m.label} <span aria-hidden="true" class="text-zinc-400">↓</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Back -->
    <a
      href={base + "filmografia/"}
      class="inline-flex items-center gap-2 text-sm text-zinc-400 transition hover:text-zinc-700"
    >
      {hasLangToggle ? (
        <>
          <span data-lang-content="it">← Torna alla filmografia</span>
          <span class="hidden" data-lang-content="en">← Back to filmography</span>
        </>
      ) : '← Torna alla filmografia'}
    </a>

  </section>
</MainLayout>

{hasLangToggle && (
  <script>
    const params = new URLSearchParams(location.search);
    const initial = params.get('lang') ?? localStorage.getItem('film-lang') ?? 'it';

    function setLang(lang: string) {
      // Presentazioni e sezioni di testo
      document.querySelectorAll<HTMLElement>('[data-lang-content]').forEach((el) => {
        const target = el.dataset.langContent;
        if (target === 'it' || target === 'en') {
          el.hidden = target !== lang;
          if (target !== lang) el.classList.add('hidden');
          else el.classList.remove('hidden');
        }
      });

      // Titolo
      const titoloIt = document.querySelector<HTMLElement>('[data-field="titolo"]');
      const titoloEn = document.querySelector<HTMLElement>('[data-field="titolo-en"]');
      if (titoloIt && titoloEn) {
        if (lang === 'en') { titoloIt.classList.add('hidden'); titoloEn.classList.remove('hidden'); }
        else { titoloIt.classList.remove('hidden'); titoloEn.classList.add('hidden'); }
      }

      // Anno
      const annoIt = document.querySelector<HTMLElement>('[data-field="anno"]');
      const annoEn = document.querySelector<HTMLElement>('[data-field="anno-en"]');
      if (annoIt && annoEn) {
        if (lang === 'en') { annoIt.classList.add('hidden'); annoEn.classList.remove('hidden'); }
        else { annoIt.classList.remove('hidden'); annoEn.classList.add('hidden'); }
      }

      // Bottoni toggle
      document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(btn.dataset.langBtn === lang));
      });

      localStorage.setItem('film-lang', lang);
    }

    document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]').forEach((btn) => {
      btn.addEventListener('click', () => setLang(btn.dataset.langBtn!));
    });

    setLang(initial === 'en' ? 'en' : 'it');
  </script>
)}

<style>
  .film-content p { margin-bottom: 1rem; }
  .film-content p:last-child { margin-bottom: 0; }
  .film-content a { color: #059669; text-decoration: underline; text-underline-offset: 3px; }
  .film-content a:hover { color: #047857; }
  .film-content a.ext-pill {
    display: inline-flex; align-items: center; gap: 4px;
    border-radius: 9999px; border: 1px solid #a7f3d0; background: #f0fdf4;
    padding: 3px 12px; font-size: 0.75rem; font-weight: 600;
    color: #059669; text-decoration: none;
  }
  .film-content a.ext-pill:hover { background: #d1fae5; color: #047857; }
  .film-content em { font-style: italic; }
  .film-content strong { font-weight: 600; color: #18181b; }

  .film-section-label {
    display: block;
    font-size: 0.65rem;
