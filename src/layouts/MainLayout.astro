---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Guido Chiesa: regista e sceneggiatore" } = Astro.props;
---

<!doctype html>
<html lang="it" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={import.meta.env.BASE_URL + "favicon_round.png"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" /> -->
    <link href="https://fonts.googleapis.com/css2?family=Agbalumo&family=BioRhyme:wght@300;400;700;800&family=Cormorant:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=Kavoon&family=Nunito+Sans:ital,opsz,wght@0,6..12,300;0,6..12,400;0,6..12,700;1,6..12,300;1,6..12,400;1,6..12,700&family=Rammetto+One&family=Sarina&family=Trade+Winds&family=Vampiro+One&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-stone-50 text-zinc-900 antialiased">
    <!-- Full-page holographic background -->
    <div id="holo-bg" aria-hidden="true">
      <div class="hb" id="hb1"></div>
      <div class="hb" id="hb2"></div>
      <div class="hb" id="hb3"></div>
      <div class="hb" id="hb4"></div>
      <div class="hb" id="hb5"></div>
    </div>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />

    <!-- Scroll-to-top button — mobile only -->
    <button
      id="scroll-top"
      aria-label="Torna in cima"
      class="fixed bottom-5 left-4 z-50 flex h-9 w-9 items-center justify-center rounded-full bg-white/60 text-zinc-500 shadow-sm backdrop-blur-sm transition-all duration-300 sm:hidden opacity-0 pointer-events-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
        <path fill-rule="evenodd" d="M10 17a.75.75 0 0 1-.75-.75V5.612L5.29 9.77a.75.75 0 0 1-1.08-1.04l5.25-5.5a.75.75 0 0 1 1.08 0l5.25 5.5a.75.75 0 1 1-1.08 1.04L10.75 5.612V16.25A.75.75 0 0 1 10 17Z" clip-rule="evenodd" />
      </svg>
    </button>

    <!-- Back button — mobile only -->
    <button
      id="back-btn"
      aria-label="Torna indietro"
      class="fixed bottom-5 right-4 z-50 flex h-9 w-9 items-center justify-center rounded-full bg-white/60 text-zinc-500 shadow-sm backdrop-blur-sm transition-all duration-300 sm:hidden opacity-0 pointer-events-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
    </button>
  </body>
</html>

<style is:global>
  /* ── Full-page holographic background (all pages) ── */
  #holo-bg {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    filter: hue-rotate(var(--holo-hue, 0deg));
    transition: filter 0.15s ease-out;
    mask-image: linear-gradient(to right, transparent 73%, rgba(0,0,0,0.5) 83%, black 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 73%, rgba(0,0,0,0.5) 83%, black 100%);
  }

  /* Gradiente base continuo — evita buchi bianchi in qualsiasi momento */
  #holo-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to left,
      hsla(0, 90%, 60%, 0.22) 0%,
      hsla(0, 80%, 65%, 0.08) 20%,
      transparent 35%);
    pointer-events: none;
  }

  .hb {
    position: absolute;
    border-radius: 50%;
    filter: blur(45px);
    will-change: transform;
  }

  /* Blob con tinte distribuite su tutto lo spettro per effetto arcobaleno */
  #hb1 {
    width: 38vw; height: 85vh;
    right: -12vw; top: -20vh;
    background: radial-gradient(ellipse, hsla(0, 100%, 60%, 0.82) 0%, hsla(0, 100%, 60%, 0.35) 50%, transparent 78%);
    animation: hb1 13s ease-in-out infinite alternate;
    animation-delay: -4s;
  }
  #hb2 {
    width: 32vw; height: 80vh;
    right: -10vw; bottom: -25vh;
    background: radial-gradient(ellipse, hsla(72, 100%, 50%, 0.78) 0%, hsla(72, 100%, 50%, 0.30) 50%, transparent 78%);
    animation: hb2 17s ease-in-out infinite alternate;
    animation-delay: -10s;
  }
  #hb3 {
    width: 28vw; height: 75vh;
    right: 2vw; top: 5vh;
    background: radial-gradient(ellipse, hsla(144, 90%, 48%, 0.76) 0%, hsla(144, 90%, 48%, 0.28) 50%, transparent 78%);
    animation: hb3 11s ease-in-out infinite alternate;
    animation-delay: -3s;
  }
  #hb4 {
    width: 24vw; height: 70vh;
    right: -5vw; top: 30vh;
    background: radial-gradient(ellipse, hsla(216, 100%, 62%, 0.76) 0%, hsla(216, 100%, 62%, 0.28) 50%, transparent 78%);
    animation: hb4 15s ease-in-out infinite alternate;
    animation-delay: -7s;
  }
  #hb5 {
    width: 30vw; height: 72vh;
    right: 5vw; bottom: -15vh;
    background: radial-gradient(ellipse, hsla(288, 95%, 65%, 0.76) 0%, hsla(288, 95%, 65%, 0.28) 50%, transparent 78%);
    animation: hb5 19s ease-in-out infinite alternate;
    animation-delay: -13s;
  }

  /* Scorrimento verticale — il range copre sempre l'intera altezza schermo */
  @keyframes hb1 {
    0%   { transform: translateY(0); }
    50%  { transform: translateY(35vh); }
    100% { transform: translateY(10vh); }
  }
  @keyframes hb2 {
    0%   { transform: translateY(0); }
    50%  { transform: translateY(-40vh); }
    100% { transform: translateY(-15vh); }
  }
  @keyframes hb3 {
    0%   { transform: translateY(0); }
    50%  { transform: translateY(40vh); }
    100% { transform: translateY(15vh); }
  }
  @keyframes hb4 {
    0%   { transform: translateY(0); }
    50%  { transform: translateY(-35vh); }
    100% { transform: translateY(-10vh); }
  }
  @keyframes hb5 {
    0%   { transform: translateY(0); }
    50%  { transform: translateY(-45vh); }
    100% { transform: translateY(-20vh); }
  }

  /* ── Page-enter animation ── */
  @keyframes page-enter {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  main {
    animation: page-enter 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* ── Scroll-reveal (all pages) ── */
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // ── Holographic engine — all pages ──
  // Continuously rotates through full rainbow spectrum (~24s per full cycle)
  let hue = 0;
  let scrollHue = 0;
  let rafId: number;
  const SPEED = 0.45; // degrees per frame at 60fps → 360° in ~13s

  function applyHue() {
    document.documentElement.style.setProperty('--holo-hue', `${hue + scrollHue}deg`);
  }

  function tick() {
    hue += SPEED;
    applyHue();
    rafId = requestAnimationFrame(tick);
  }
  rafId = requestAnimationFrame(tick);

  // Scroll accelerates the rainbow shift (±60°)
  window.addEventListener('scroll', () => {
    const maxScroll = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    const progress = window.scrollY / maxScroll;
    scrollHue = (progress - 0.5) * 120;
    applyHue();
  }, { passive: true });

  // ── Scroll-reveal — all pages ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        setTimeout(() => el.classList.add('is-visible'), Number(el.dataset.delay ?? 0));
        observer.unobserve(el);
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => observer.observe(el));

  // ── Scroll-to-top button ──
  const scrollTopBtn = document.getElementById('scroll-top');
  if (scrollTopBtn) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        scrollTopBtn.classList.remove('opacity-0', 'pointer-events-none');
        scrollTopBtn.classList.add('opacity-100');
      } else {
        scrollTopBtn.classList.add('opacity-0', 'pointer-events-none');
        scrollTopBtn.classList.remove('opacity-100');
      }
    }, { passive: true });

    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // ── Back button ──
  const backBtn = document.getElementById('back-btn');
  if (backBtn && history.length > 1) {
    backBtn.classList.remove('opacity-0', 'pointer-events-none');
    backBtn.classList.add('opacity-100');
    backBtn.addEventListener('click', () => history.back());
  }
</script>
