---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Guido Chiesa: regista e sceneggiatore" } = Astro.props;
---

<!doctype html>
<html lang="it" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={import.meta.env.BASE_URL + "favicon_round.png"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" /> -->
    <link href="https://fonts.googleapis.com/css2?family=Agbalumo&family=BioRhyme:wght@300;400;700;800&family=Cormorant:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=Kavoon&family=Nunito+Sans:ital,opsz,wght@0,6..12,300;0,6..12,400;0,6..12,700;1,6..12,300;1,6..12,400;1,6..12,700&family=Rammetto+One&family=Sarina&family=Trade+Winds&family=Vampiro+One&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-stone-50 text-zinc-900 antialiased">
    <!-- Full-page holographic background -->
    <div id="holo-bg" aria-hidden="true">
      <div class="hb" id="hb1"></div>
      <div class="hb" id="hb2"></div>
      <div class="hb" id="hb3"></div>
      <div class="hb" id="hb4"></div>
      <div class="hb" id="hb5"></div>
    </div>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />

    <!-- Scroll-to-top button — mobile only -->
    <button
      id="scroll-top"
      aria-label="Torna in cima"
      class="fixed bottom-5 left-4 z-50 flex h-9 w-9 items-center justify-center rounded-full bg-white/60 text-zinc-500 shadow-sm backdrop-blur-sm transition-all duration-300 sm:hidden opacity-0 pointer-events-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
        <path fill-rule="evenodd" d="M10 17a.75.75 0 0 1-.75-.75V5.612L5.29 9.77a.75.75 0 0 1-1.08-1.04l5.25-5.5a.75.75 0 0 1 1.08 0l5.25 5.5a.75.75 0 1 1-1.08 1.04L10.75 5.612V16.25A.75.75 0 0 1 10 17Z" clip-rule="evenodd" />
      </svg>
    </button>

    <!-- Back button — mobile only -->
    <button
      id="back-btn"
      aria-label="Torna indietro"
      class="fixed bottom-5 right-4 z-50 flex h-9 w-9 items-center justify-center rounded-full bg-white/60 text-zinc-500 shadow-sm backdrop-blur-sm transition-all duration-300 sm:hidden opacity-0 pointer-events-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
    </button>
  </body>
</html>

<style is:global>
  /* ── Full-page holographic background (all pages) ── */
  #holo-bg {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    filter: hue-rotate(var(--holo-hue, 0deg));
    transition: filter 0.15s ease-out;
    mask-image: linear-gradient(to right, transparent 20%, rgba(0,0,0,0.4) 45%, black 68%);
    -webkit-mask-image: linear-gradient(to right, transparent 20%, rgba(0,0,0,0.4) 45%, black 68%);
  }

  .hb {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  #hb1 {
    width: 70%; height: 65%;
    right: -15%; top: -20%;
    background: radial-gradient(circle, hsla(10, 100%, 55%, 0.82) 0%, hsla(10, 100%, 55%, 0.30) 40%, transparent 65%);
    animation: hb1 20s ease-in-out infinite alternate;
  }
  #hb2 {
    width: 60%; height: 60%;
    right: -10%; bottom: -15%;
    background: radial-gradient(circle, hsla(28, 100%, 52%, 0.75) 0%, hsla(28, 100%, 52%, 0.25) 40%, transparent 65%);
    animation: hb2 26s ease-in-out infinite alternate;
  }
  #hb3 {
    width: 52%; height: 52%;
    right: 5%; top: -10%;
    background: radial-gradient(circle, hsla(18, 100%, 60%, 0.70) 0%, hsla(18, 100%, 60%, 0.22) 40%, transparent 65%);
    animation: hb3 17s ease-in-out infinite alternate;
  }
  #hb4 {
    width: 48%; height: 55%;
    right: -5%; top: 25%;
    background: radial-gradient(circle, hsla(4, 100%, 58%, 0.68) 0%, hsla(4, 100%, 58%, 0.20) 40%, transparent 65%);
    animation: hb4 22s ease-in-out infinite alternate;
  }
  #hb5 {
    width: 45%; height: 45%;
    right: 15%; bottom: -15%;
    background: radial-gradient(circle, hsla(33, 95%, 54%, 0.65) 0%, hsla(33, 95%, 54%, 0.20) 40%, transparent 65%);
    animation: hb5 30s ease-in-out infinite alternate;
  }

  @keyframes hb1 {
    0%   { transform: translate(0,   0); }
    33%  { transform: translate(-18%, 28%); }
    66%  { transform: translate(-8%,  55%); }
    100% { transform: translate(-28%, 15%); }
  }
  @keyframes hb2 {
    0%   { transform: translate(0,    0); }
    33%  { transform: translate(-20%, -30%); }
    66%  { transform: translate(-5%,  -55%); }
    100% { transform: translate(-30%, -18%); }
  }
  @keyframes hb3 {
    0%   { transform: translate(0,   0); }
    50%  { transform: translate(-15%, 50%); }
    100% { transform: translate(-30%, 20%); }
  }
  @keyframes hb4 {
    0%   { transform: translate(0,    0); }
    50%  { transform: translate(-25%, 35%); }
    100% { transform: translate(-10%, 60%); }
  }
  @keyframes hb5 {
    0%   { transform: translate(0,   0); }
    33%  { transform: translate(-20%, -25%); }
    66%  { transform: translate(10%,  -40%); }
    100% { transform: translate(-15%, -15%); }
  }

  /* ── Page-enter animation ── */
  @keyframes page-enter {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  main {
    animation: page-enter 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* ── Scroll-reveal (all pages) ── */
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // ── Holographic engine — all pages ──
  // Oscillates within warm hues only (reds, oranges, pinks — no blues or greens)
  let time = 0;
  let scrollHue = 0;
  let rafId: number;
  const SPEED = 0.004; // radians per frame
  const WARM_RANGE = 12; // ± degrees — strictly red/orange/amber, never green

  function applyHue() {
    const hue = Math.sin(time) * WARM_RANGE + scrollHue;
    document.documentElement.style.setProperty('--holo-hue', `${hue}deg`);
  }

  function tick() {
    time += SPEED;
    applyHue();
    rafId = requestAnimationFrame(tick);
  }
  rafId = requestAnimationFrame(tick);

  // Scroll adds a tiny warm offset (max ±12°)
  window.addEventListener('scroll', () => {
    const maxScroll = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    const progress = window.scrollY / maxScroll;
    scrollHue = (progress - 0.5) * 24;
    applyHue();
  }, { passive: true });

  // ── Scroll-reveal — all pages ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        setTimeout(() => el.classList.add('is-visible'), Number(el.dataset.delay ?? 0));
        observer.unobserve(el);
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => observer.observe(el));

  // ── Scroll-to-top button ──
  const scrollTopBtn = document.getElementById('scroll-top');
  if (scrollTopBtn) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        scrollTopBtn.classList.remove('opacity-0', 'pointer-events-none');
        scrollTopBtn.classList.add('opacity-100');
      } else {
        scrollTopBtn.classList.add('opacity-0', 'pointer-events-none');
        scrollTopBtn.classList.remove('opacity-100');
      }
    }, { passive: true });

    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // ── Back button ──
  const backBtn = document.getElementById('back-btn');
  if (backBtn && history.length > 1) {
    backBtn.classList.remove('opacity-0', 'pointer-events-none');
    backBtn.classList.add('opacity-100');
    backBtn.addEventListener('click', () => history.back());
  }
</script>
