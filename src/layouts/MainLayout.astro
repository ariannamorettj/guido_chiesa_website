---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Guido Chiesa: regista e sceneggiatore" } = Astro.props;
---

<!doctype html>
<html lang="it" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={import.meta.env.BASE_URL + "favicon_round.png"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" /> -->
    <link href="https://fonts.googleapis.com/css2?family=Agbalumo&family=BioRhyme:wght@300;400;700;800&family=Cormorant:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=Jost:wght@400;500;600;700&family=Kavoon&family=Nunito+Sans:ital,opsz,wght@0,6..12,300;0,6..12,400;0,6..12,700;1,6..12,300;1,6..12,400;1,6..12,700&family=Rammetto+One&family=Sarina&family=Trade+Winds&family=Vampiro+One&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-stone-50 text-zinc-900 antialiased">
    <!-- Full-page holographic background -->
    <div id="holo-bg" aria-hidden="true">
      <div class="hb" id="hb1"></div>
      <div class="hb" id="hb2"></div>
      <div class="hb" id="hb3"></div>
      <div class="hb" id="hb4"></div>
      <div class="hb" id="hb5"></div>
    </div>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />

    <!-- Scroll-to-top button — mobile only -->
    <button
      id="scroll-top"
      aria-label="Torna in cima"
      class="fixed bottom-5 left-4 z-50 flex h-9 w-9 items-center justify-center rounded-full bg-white/60 text-zinc-500 shadow-sm backdrop-blur-sm transition-all duration-300 sm:hidden opacity-0 pointer-events-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
        <path fill-rule="evenodd" d="M10 17a.75.75 0 0 1-.75-.75V5.612L5.29 9.77a.75.75 0 0 1-1.08-1.04l5.25-5.5a.75.75 0 0 1 1.08 0l5.25 5.5a.75.75 0 1 1-1.08 1.04L10.75 5.612V16.25A.75.75 0 0 1 10 17Z" clip-rule="evenodd" />
      </svg>
    </button>

    <!-- Back button — mobile only -->
    <button
      id="back-btn"
      aria-label="Torna indietro"
      class="fixed bottom-5 right-4 z-50 flex h-9 w-9 items-center justify-center rounded-full bg-white/60 text-zinc-500 shadow-sm backdrop-blur-sm transition-all duration-300 sm:hidden opacity-0 pointer-events-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
    </button>
  </body>
</html>

<style is:global>
  /* ── Full-page holographic background (all pages) ── */
  #holo-bg {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    filter: hue-rotate(var(--holo-hue, 0deg));
    transition: filter 0.15s ease-out;
    mask-image: linear-gradient(to right, transparent 73%, rgba(0,0,0,0.5) 83%, black 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 73%, rgba(0,0,0,0.5) 83%, black 100%);
  }

  /* Gradiente base continuo — evita buchi bianchi in qualsiasi momento */
  #holo-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to left,
      hsla(0, 90%, 60%, 0.22) 0%,
      hsla(0, 80%, 65%, 0.08) 20%,
      transparent 35%);
    pointer-events: none;
  }

  .hb {
    position: absolute;
    border-radius: 50%;
    filter: blur(45px);
    will-change: transform;
  }

  /* Blob con tinte distribuite su tutto lo spettro per effetto arcobaleno */
  #hb1 {
    width: 38vw; height: 85vh;
    right: -12vw; top: -20vh;
    background: radial-gradient(ellipse, hsla(0, 100%, 60%, 0.82) 0%, hsla(0, 100%, 60%, 0.35) 50%, transparent 78%);
    animation: hb1 13s ease-in-out infinite alternate;
    animation-delay: -4s;
  }
  #hb2 {
    width: 32vw; height: 80vh;
    right: -10vw; bottom: -25vh;
    background: radial-gradient(ellipse, hsla(72, 100%, 50%, 0.78) 0%, hsla(72, 100%, 50%, 0.30) 50%, transparent 78%);
    animation: hb2 17s ease-in-out infinite alternate;
    animation-delay: -10s;
  }
  #hb3 {
    width: 28vw; height: 75vh;
    right: 2vw; top: 5vh;
    background: radial-gradient(ellipse, hsla(144, 90%, 48%, 0.76) 0%, hsla(144, 90%, 48%, 0.28) 50%, transparent 78%);
    animation: hb3 11s ease-in-out infinite alternate;
    animation-delay: -3s;
  }
  #hb4 {
    width: 24vw; height: 70vh;
    right: -5vw; top: 30vh;
    background: radial-gradient(ellipse, hsla(216, 100%, 62%, 0.76) 0%, hsla(216, 100%, 62%, 0.28) 50%, transparent 78%);
    animation: hb4 15s ease-in-out infinite alternate;
    animation-delay: -7s;
  }
  #hb5 {
    width: 30vw; height: 72vh;
    right: 5vw; bottom: -15vh;
    background: radial-gradient(ellipse, hsla(288, 95%, 65%, 0.76) 0%, hsla(288, 95%, 65%, 0.28) 50%, transparent 78%);
    animation: hb5 19s ease-in-out infinite alternate;
    animation-delay: -13s;
  }

  /* Scorrimento verticale — il range copre sempre l'intera altezza schermo */
  @keyframes hb1 {
    0%   { transform: translateY(0); }
    50%  { transform: translateY(35vh); }
    100% { transform: translateY(10vh); }
  }
  @keyframes hb2 {
    0%   { transform: translateY(0); }
    50%  { transform: translateY(-40vh); }
    100% { transform: translateY(-15vh); }
  }
  @keyframes hb3 {
    0%   { transform: translateY(0); }
    50%  { transform: translateY(40vh); }
    100% { transform: translateY(15vh); }
  }
  @keyframes hb4 {
    0%   { transform: translateY(0); }
    50%  { transform: translateY(-35vh); }
    100% { transform: translateY(-10vh); }
  }
  @keyframes hb5 {
    0%   { transform: translateY(0); }
    50%  { transform: translateY(-45vh); }
    100% { transform: translateY(-20vh); }
  }

  /* ── Page-enter animation ── */
  @keyframes page-enter {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  main {
    animation: page-enter 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* ── Scroll-reveal (all pages) ── */
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Import dinamico: pdf.js (e il suo worker) pesano ~130KB gzip e vanno
  // scaricati solo sulle pagine dove viene effettivamente aperto un PDF,
  // non su tutto il sito (questo script è condiviso da ogni pagina).
  let pdfjsLibPromise: ReturnType<typeof loadPdfjsLib> | null = null;
  async function loadPdfjsLib() {
    const [lib, worker] = await Promise.all([
      import('pdfjs-dist'),
      import('pdfjs-dist/build/pdf.worker.min.mjs?url'),
    ]);
    lib.GlobalWorkerOptions.workerSrc = worker.default;
    return lib;
  }

  // Disegna il PDF pagina per pagina come <canvas> dentro un contenitore
  // normale, invece di affidarsi al viewer nativo in un <iframe>: su
  // mobile (soprattutto iOS Safari) quel viewer, annidato in una finestra
  // sovrapposta, non scorre in modo affidabile — un <canvas> dentro un div
  // scorrevole invece si comporta esattamente come l'immagine di rassegna
  // stampa, su qualsiasi dispositivo.
  async function renderPdfPages(container: HTMLElement, url: string) {
    pdfjsLibPromise ??= loadPdfjsLib();
    const pdfjsLib = await pdfjsLibPromise;
    const pdf = await pdfjsLib.getDocument({ url }).promise;
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
      const page = await pdf.getPage(pageNum);
      const cssWidth = container.clientWidth || 672;
      const unscaled = page.getViewport({ scale: 1 });
      const scale = (cssWidth * dpr) / unscaled.width;
      const viewport = page.getViewport({ scale });
      const canvas = document.createElement('canvas');
      canvas.className = 'file-modal-pdfPage';
      canvas.width = Math.ceil(viewport.width);
      canvas.height = Math.ceil(viewport.height);
      canvas.style.width = `${cssWidth}px`;
      canvas.style.height = `${viewport.height / dpr}px`;
      container.appendChild(canvas);
      const ctx = canvas.getContext('2d');
      if (!ctx) continue;
      await page.render({ canvasContext: ctx, viewport }).promise;
    }
  }

  // ── Holographic engine — all pages ──
  // Continuously rotates through full rainbow spectrum (~24s per full cycle)
  let hue = 0;
  let scrollHue = 0;
  let rafId: number;
  const SPEED = 0.45; // degrees per frame at 60fps → 360° in ~13s

  function applyHue() {
    document.documentElement.style.setProperty('--holo-hue', `${hue + scrollHue}deg`);
  }

  function tick() {
    hue += SPEED;
    applyHue();
    rafId = requestAnimationFrame(tick);
  }
  rafId = requestAnimationFrame(tick);

  // Scroll accelerates the rainbow shift (±60°)
  window.addEventListener('scroll', () => {
    const maxScroll = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    const progress = window.scrollY / maxScroll;
    scrollHue = (progress - 0.5) * 120;
    applyHue();
  }, { passive: true });

  // ── Scroll-reveal — all pages ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        setTimeout(() => el.classList.add('is-visible'), Number(el.dataset.delay ?? 0));
        observer.unobserve(el);
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => observer.observe(el));

  // ── Spinner di caricamento immagini — all pages ──
  // Copre ogni <img> ancora in caricamento con un overlay opaco (anello
  // arcobaleno soft, .img-loading-overlay in global.css), rimosso in
  // dissolvenza al load; salta le immagini già in cache (niente flash).
  document.querySelectorAll<HTMLImageElement>('img').forEach((img) => {
    if (img.complete) return;
    const parent = img.parentElement;
    if (!parent) return;
    if (getComputedStyle(parent).position === 'static') {
      parent.classList.add('img-loading-wrap');
    }
    const overlay = document.createElement('span');
    overlay.className = 'img-loading-overlay';
    overlay.setAttribute('aria-hidden', 'true');
    img.insertAdjacentElement('afterend', overlay);
    const clear = () => {
      overlay.style.opacity = '0';
      overlay.addEventListener('transitionend', () => overlay.remove(), { once: true });
    };
    img.addEventListener('load', clear, { once: true });
    img.addEventListener('error', clear, { once: true });
  });

  // ── Scroll-to-top button ──
  const scrollTopBtn = document.getElementById('scroll-top');
  if (scrollTopBtn) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        scrollTopBtn.classList.remove('opacity-0', 'pointer-events-none');
        scrollTopBtn.classList.add('opacity-100');
      } else {
        scrollTopBtn.classList.add('opacity-0', 'pointer-events-none');
        scrollTopBtn.classList.remove('opacity-100');
      }
    }, { passive: true });

    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // ── Back button ──
  const backBtn = document.getElementById('back-btn');
  if (backBtn && history.length > 1) {
    backBtn.classList.remove('opacity-0', 'pointer-events-none');
    backBtn.classList.add('opacity-100');
    backBtn.addEventListener('click', () => history.back());
  }

  // ── Anteprima file (PDF/immagini) al posto del download diretto ──
  // Intercetta i link locali verso pdf/doc/jpg/png e apre una card con
  // anteprima incorporata + bottone di download, invece di navigare via.
  const FILE_EXT = /\.(pdf|docx?|jpe?g|png)(?:[?#]|$)/i;
  const PDF_EXT = /\.pdf(?:[?#]|$)/i;
  const IMG_EXT = /\.(jpe?g|png)(?:[?#]|$)/i;

  function cleanFileTitle(raw: string): string {
    return raw.replace(/[↓↗↑→▶]/g, '').replace(/\s+/g, ' ').trim() || 'Anteprima file';
  }

  function closeFileModal(overlay: HTMLElement) {
    overlay.classList.remove('is-visible');
    document.body.classList.remove('file-modal-open');
    window.removeEventListener('keydown', onFileModalKeydown);
    overlay.addEventListener('transitionend', () => overlay.remove(), { once: true });
  }

  let activeFileModal: HTMLElement | null = null;
  function onFileModalKeydown(e: KeyboardEvent) {
    if (e.key === 'Escape' && activeFileModal) closeFileModal(activeFileModal);
  }

  function openFileModal(url: string, rawTitle: string) {
    const title = cleanFileTitle(rawTitle);
    const overlay = document.createElement('div');
    overlay.className = 'file-modal-overlay';

    const card = document.createElement('div');
    card.className = 'file-modal-card';

    const header = document.createElement('div');
    header.className = 'file-modal-header';
    const titleEl = document.createElement('div');
    titleEl.className = 'file-modal-title';
    titleEl.textContent = title;
    const closeBtn = document.createElement('button');
    closeBtn.type = 'button';
    closeBtn.className = 'file-modal-close';
    closeBtn.setAttribute('aria-label', 'Chiudi anteprima');
    closeBtn.textContent = '✕';
    header.append(titleEl, closeBtn);

    const body = document.createElement('div');
    body.className = 'file-modal-body';
    if (PDF_EXT.test(url)) {
      const pdfContainer = document.createElement('div');
      pdfContainer.className = 'file-modal-pdf';
      const loading = document.createElement('div');
      loading.className = 'file-modal-noPreview';
      loading.textContent = 'Caricamento anteprima…';
      pdfContainer.appendChild(loading);
      body.appendChild(pdfContainer);
      renderPdfPages(pdfContainer, url)
        .then(() => { loading.remove(); onResize(); })
        .catch((err) => {
          console.error('[pdf-preview]', err);
          pdfContainer.replaceChildren();
          const note = document.createElement('div');
          note.className = 'file-modal-noPreview';
          note.textContent = 'Anteprima non disponibile per questo file: scarica il file per aprirlo.';
          pdfContainer.appendChild(note);
          onResize();
        });
    } else if (IMG_EXT.test(url)) {
      const img = document.createElement('img');
      img.src = url;
      img.alt = title;
      body.appendChild(img);
    } else {
      const note = document.createElement('div');
      note.className = 'file-modal-noPreview';
      note.textContent = 'Anteprima non disponibile per questo formato: scarica il file per aprirlo.';
      body.appendChild(note);
    }

    const footer = document.createElement('div');
    footer.className = 'file-modal-footer';
    const downloadLink = document.createElement('a');
    downloadLink.href = url;
    downloadLink.setAttribute('download', '');
    downloadLink.className = 'file-modal-download';
    downloadLink.textContent = '↓ Scarica';
    footer.appendChild(downloadLink);

    // Indicatore di scroll colorato, sovrapposto via JS: elemento a parte
    // (non tocca .file-modal-body, che resta esattamente com'era). Serve
    // solo perché su iOS Safari la barra di scroll nativa non è
    // personalizzabile via CSS e resta sempre nera.
    const scrollbarTrack = document.createElement('div');
    scrollbarTrack.className = 'file-modal-scrollbar-track';
    const scrollbarThumb = document.createElement('div');
    scrollbarThumb.className = 'file-modal-scrollbar-thumb';
    scrollbarTrack.appendChild(scrollbarThumb);

    function positionTrack() {
      const cardRect = card.getBoundingClientRect();
      const bodyRect = body.getBoundingClientRect();
      scrollbarTrack.style.top = `${bodyRect.top - cardRect.top + 8}px`;
      scrollbarTrack.style.height = `${bodyRect.height - 16}px`;
    }
    function updateThumb() {
      const { scrollTop, scrollHeight, clientHeight } = body;
      const canScroll = scrollHeight > clientHeight + 1;
      scrollbarTrack.classList.toggle('is-visible', canScroll);
      if (!canScroll) return;
      const trackHeight = scrollbarTrack.clientHeight;
      const thumbHeight = Math.max(24, (clientHeight / scrollHeight) * trackHeight);
      const maxTop = trackHeight - thumbHeight;
      const top = (scrollTop / (scrollHeight - clientHeight)) * maxTop;
      scrollbarThumb.style.height = `${thumbHeight}px`;
      scrollbarThumb.style.transform = `translateY(${top}px)`;
    }
    function onResize() { positionTrack(); updateThumb(); }
    body.addEventListener('scroll', updateThumb, { passive: true });
    body.querySelectorAll('img').forEach((el) => el.addEventListener('load', onResize));
    window.addEventListener('resize', onResize);

    card.append(header, body, footer, scrollbarTrack);
    overlay.appendChild(card);
    document.body.appendChild(overlay);
    document.body.classList.add('file-modal-open');
    activeFileModal = overlay;

    requestAnimationFrame(() => {
      overlay.classList.add('is-visible');
      onResize();
    });

    const doClose = () => {
      activeFileModal = null;
      window.removeEventListener('resize', onResize);
      closeFileModal(overlay);
    };
    closeBtn.addEventListener('click', doClose);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) doClose(); });
    window.addEventListener('keydown', onFileModalKeydown);
  }

  document.addEventListener('click', (e) => {
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.defaultPrevented) return;
    const link = (e.target as HTMLElement).closest('a');
    if (!link) return;
    const href = link.getAttribute('href');
    if (!href || !FILE_EXT.test(href)) return;
    let resolved: URL;
    try {
      resolved = new URL(link.href);
    } catch {
      return;
    }
    if (resolved.origin !== location.origin) return;
    e.preventDefault();
    // innerText (non textContent) rispetta le interruzioni di riga tra i figli
    // block-level: per i link con titolo + fonte + badge su righe separate
    // (es. rassegna stampa) prende solo la prima riga, cioè il titolo.
    const firstLine = link.innerText.split('\n').map((s) => s.trim()).find(Boolean) || '';
    openFileModal(resolved.href, firstLine);
  });
</script>
